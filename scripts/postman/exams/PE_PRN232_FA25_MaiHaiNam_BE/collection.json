    {
      "name": "BearProfiles - Get All (Manager)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_manager}}" }
        ],
        "url": { "raw": "{{baseUrl}}/BearProfiles", "host": [ "{{baseUrl}}" ], "path": [ "BearProfiles" ] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('Response is array', function () { pm.expect(json).to.be.an('array'); });",
              "if (Array.isArray(json) && json.length > 0) {",
              "  var first = json[0];",
              "  var id = first.bearProfileId || first.BearProfileId || first.bearProfileID || first.BearProfileID;",
              "  var bt = first.bearTypeId || first.BearTypeId;",
              "  if (id) pm.environment.set('firstId', id);",
              "  if (bt) pm.environment.set('bearTypeId', bt);",
              "  pm.environment.set('hasProfiles', 'true');",
              "  pm.test('Has required fields', function () {",
              "    pm.expect(first).to.have.property('bearName');",
              "    pm.expect(first).to.have.property('weight');",
              "    pm.expect(first).to.have.property('bearTypeId');",
              "    pm.expect(first).to.have.property('modifiedDate');",
              "  });",
              "} else {",
              "  pm.environment.set('hasProfiles', 'false');",
              "}"
            ]
          }
        }
      ]
    },
