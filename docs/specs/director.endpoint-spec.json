{
  "basePath": "/api",
  "endpoints": [
    {
      "name": "GetDirectors",
      "method": "GET",
      "route": "/Director/getdirectors/{nationality}/{gender}",
      "params": [
        { "name": "nationality", "in": "path", "type": "string" },
        { "name": "gender", "in": "path", "type": "string" }
      ],
      "response": {
        "type": "array",
        "items": {
          "fields": [
            { "name": "id", "type": "int" },
            { "name": "fullName", "type": "string" },
            { "name": "gender", "type": "string" },
            { "name": "dob", "type": "string" },
            { "name": "dobString", "type": "string", "format": "M/d/yyyy" },
            { "name": "nationality", "type": "string" }
          ]
        }
      }
    },
    {
      "name": "GetDirector",
      "method": "GET",
      "route": "/Director/getdirector/{id}",
      "params": [
        { "name": "id", "in": "path", "type": "int" }
      ],
      "response": {
        "type": "object",
        "fields": [
          { "name": "id", "type": "int" },
          { "name": "fullName", "type": "string" },
          { "name": "dobString", "type": "string", "format": "M/d/yyyy" },
          { "name": "movies", "type": "array" },
          { "name": "genres", "type": "array", "expected": "empty" },
          { "name": "stars", "type": "array", "expected": "empty" }
        ]
      }
    },
    {
      "name": "CreateDirector",
      "method": "POST",
      "route": "/Director/create",
      "params": [],
      "request": {
        "body": {
          "fields": [
            { "name": "fullName", "type": "string" },
            { "name": "male", "type": "bool" },
            { "name": "dob", "type": "string" },
            { "name": "nationality", "type": "string" },
            { "name": "description", "type": "string" }
          ]
        }
      },
      "response": {
        "type": "int"
      },
      "errors": [
        { "status": 409, "message": "There is an error while adding." }
      ]
    }
  ]
}
